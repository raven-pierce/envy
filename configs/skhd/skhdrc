# ===============================================
# APPLICATION SHORTCUTS
# ===============================================
rcmd - return : open -n -a "warp"
# rcmd - return : open -n -a "ghostty"

# ===============================================
# SPACE/DESKTOP MANAGEMENT
# ===============================================

# Create new space and focus it
cmd + alt - n : yabai -m space --create && \
    index="$(yabai -m query --spaces --display | jq 'map(select(."native-fullscreen" == 0))[-1].index')" && \
    yabai -m space --focus "${index}"

# Destroy current space
cmd + alt - w : yabai -m space --destroy

# Change space layout
# ctrl + alt - b : yabai -m space --layout bsp
# ctrl + alt - f : yabai -m space --layout float
# ctrl + alt - s : yabai -m space --layout stack

# Space transformations
shift + alt - r : yabai -m space --rotate 270
shift + alt - y : yabai -m space --mirror y-axis
shift + alt - x : yabai -m space --mirror x-axis
shift + alt - e : yabai -m space --balance

# ===============================================
# DISPLAY MANAGEMENT
# ===============================================

# Focus between displays
alt - e : yabai -m display --focus east
alt - w : yabai -m display --focus west
# alt - u : yabai -m display --focus north
# alt - d : yabai -m display --focus south

# Move window to display
shift + alt - g : yabai -m window --display west; yabai -m display --focus west;
shift + alt - d : yabai -m window --display east; yabai -m display --focus east;

# ===============================================
# WINDOW MANAGEMENT
# ===============================================

# Window states
shift + alt - t : yabai -m window --toggle float --grid 4:4:1:1:2:2
shift + alt - f : yabai -m window --toggle zoom-fullscreen

# Swap windows
shift + alt - j : yabai -m window --swap south
shift + alt - k : yabai -m window --swap north
shift + alt - h : yabai -m window --swap west
shift + alt - l : yabai -m window --swap east

# Move window and split
ctrl + alt - j : yabai -m window --warp south
ctrl + alt - k : yabai -m window --warp north
ctrl + alt - h : yabai -m window --warp west
ctrl + alt - l : yabai -m window --warp east

# Resize windows
cmd + alt - h : yabai -m window west --resize right:-20:0 2> /dev/null || yabai -m window --resize right:-20:0
cmd + alt - j : yabai -m window north --resize bottom:0:20 2> /dev/null || yabai -m window --resize bottom:0:20
cmd + alt - k : yabai -m window south --resize top:0:-20 2> /dev/null || yabai -m window --resize top:0:-20
cmd + alt - l : yabai -m window east --resize left:20:0 2> /dev/null || yabai -m window --resize left:20:0

# Move window to specific space
shift + alt - 1 : yabai -m window --space 1;
shift + alt - 2 : yabai -m window --space 2;
shift + alt - 3 : yabai -m window --space 3;
shift + alt - 4 : yabai -m window --space 4;
shift + alt - 5 : yabai -m window --space 5;
